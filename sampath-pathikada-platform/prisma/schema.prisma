// ─────────────────────────────────────────────────────────────────────────────
// Sampath Pathikada — Prisma Schema (MySQL)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../lib/prisma-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ECONOMIC_DEVELOPMENT_OFFICER
  ASSISTANT_DIRECTOR_PLANNING
  DIVISIONAL_SECRETARIAT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum AuditCategory {
  AUTH
  USER
  ADMIN
  SYSTEM
  DATA
  REGISTRATION
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  AD_APPROVED
  APPROVED
  REJECTED
  REVISION_NEEDED
}

// AD = Assistant Director Planning reviews first; DS = Divisional Secretariat reviews second
// (final). Tracks whose queue a submission is in right now, independent of `status` — see
// lib/submission-review.ts `deriveSubmissionStatus` for how the two are kept in sync.
enum ReviewStage {
  AD
  DS
}

enum VerificationDocType {
  NIC
  DRIVING_LICENSE
  PASSPORT
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(cuid())
  email             String     @unique @db.VarChar(255)
  passwordHash      String     @db.VarChar(255)
  name              String     @db.VarChar(120)
  nameSinhala       String?    @db.VarChar(120)
  phone             String?    @db.VarChar(20)
  nic               String?    @unique @db.VarChar(20)
  role              UserRole
  status            UserStatus @default(ACTIVE)

  // Geographic assignment
  district          String?    @db.VarChar(80)
  dsDivision        String?    @db.VarChar(80)
  gnDivision        String?    @db.VarChar(80)

  // Additional details captured at registration (Economic Development Officers only) —
  // copied from EconomicDevelopmentOfficerRegistration on approval, used to pre-fill the
  // Identification section of the yearly submission.
  localGovt         String?    @db.VarChar(200)
  electoral         String?    @db.VarChar(200)
  farmers           String?    @db.VarChar(200)
  eduZone           String?    @db.VarChar(200)
  eduDiv            String?    @db.VarChar(200)
  mahaweli          String?    @db.VarChar(200)

  // Auth / security
  lastLoginAt       DateTime?
  lastLoginIp       String?    @db.VarChar(45)
  loginAttempts     Int        @default(0)
  lockedUntil       DateTime?
  mustResetPassword Boolean    @default(false)
  emailVerified     Boolean    @default(false)

  // Meta
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdById       String?

  // Relations — one per registration table
  auditLogs                    AuditLog[]
  submissions                  Submission[]
  gnApprovals                  EconomicDevelopmentOfficerRegistration[] @relation("GnApprovedBy")
  assistantDirectorPlanningApprovals AssistantDirectorPlanningRegistration[] @relation("AdApprovedBy")
  divisionalSecretariatApprovals DivisionalSecretariatRegistration[] @relation("DsApprovedBy")
  divisionProfileApprovals     DivisionProfile[] @relation("DivisionProfileApprovedBy")

  @@index([email])
  @@index([role])
  @@index([district])
  @@map("users")
}

// ─── 1. Economic Development Officer Registrations ───────────────────────────
//    Table: economic_development_officer_registrations
//    gnDivision is required — Economic Development Officers are assigned to a specific division

model EconomicDevelopmentOfficerRegistration {
  id                   String             @id @default(cuid())

  firstName            String?            @db.VarChar(80)
  lastName             String?            @db.VarChar(80)
  name                 String             @db.VarChar(120)   // full name as in NIC
  email                String             @db.VarChar(255)
  phone                String             @db.VarChar(20)
  nic                  String             @db.VarChar(20)
  passwordHash         String             @db.VarChar(255)

  // Verification document — temporary only, deleted the instant Super Admin approves/rejects
  verificationDocType      VerificationDocType?
  verificationDocFrontPath String?              @db.VarChar(500)
  verificationDocBackPath  String?              @db.VarChar(500)
  verificationDocDeletedAt DateTime?

  district             String             @db.VarChar(80)
  dsDivision           String             @db.VarChar(80)
  gnDivision           String             @db.VarChar(80)

  localGovt            String?            @db.VarChar(200)
  electoral            String?            @db.VarChar(200)
  farmers              String?            @db.VarChar(200)
  eduZone              String?            @db.VarChar(200)
  eduDiv               String?            @db.VarChar(200)
  mahaweli             String?            @db.VarChar(200)

  status               RegistrationStatus @default(PENDING)
  rejectionNote        String?            @db.Text
  approvedAt           DateTime?
  approvedById         String?
  approvedBy           User?              @relation("GnApprovedBy", fields: [approvedById], references: [id])

  submittedAt          DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  submittedFromIp      String?            @db.VarChar(45)

  @@index([status])
  @@index([district])
  @@index([dsDivision])
  @@index([gnDivision])
  @@index([email])
  @@index([nic])
  @@map("economic_development_officer_registrations")
}

// ─── 2. Assistant Director Planning Registrations ─────────────────────────────
//    Table: assistant_director_planning_registrations
//    Structural mirror of DivisionalSecretariatRegistration — dsDivision-scoped, no gnDivision.

model AssistantDirectorPlanningRegistration {
  id                   String             @id @default(cuid())

  firstName            String?            @db.VarChar(80)
  lastName             String?            @db.VarChar(80)
  name                 String             @db.VarChar(120)   // full name as in NIC
  email                String             @db.VarChar(255)
  phone                String             @db.VarChar(20)
  nic                  String             @db.VarChar(20)
  passwordHash         String             @db.VarChar(255)

  // Verification document — temporary only, deleted the instant Super Admin approves/rejects
  verificationDocType      VerificationDocType?
  verificationDocFrontPath String?              @db.VarChar(500)
  verificationDocBackPath  String?              @db.VarChar(500)
  verificationDocDeletedAt DateTime?

  district             String             @db.VarChar(80)
  dsDivision           String             @db.VarChar(80)

  status               RegistrationStatus @default(PENDING)
  rejectionNote        String?            @db.Text
  approvedAt           DateTime?
  approvedById         String?
  approvedBy           User?              @relation("AdApprovedBy", fields: [approvedById], references: [id])

  submittedAt          DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  submittedFromIp      String?            @db.VarChar(45)

  @@index([status])
  @@index([district])
  @@index([dsDivision])
  @@index([email])
  @@index([nic])
  @@map("assistant_director_planning_registrations")
}

// ─── 3. Divisional Secretariat Registrations ─────────────────────────────────
//    Table: divisional_secretariat_registrations

model DivisionalSecretariatRegistration {
  id                   String             @id @default(cuid())

  firstName            String?            @db.VarChar(80)
  lastName             String?            @db.VarChar(80)
  name                 String             @db.VarChar(120)   // full name as in NIC
  email                String             @db.VarChar(255)
  phone                String             @db.VarChar(20)
  nic                  String             @db.VarChar(20)
  passwordHash         String             @db.VarChar(255)

  // Verification document — temporary only, deleted the instant Super Admin approves/rejects
  verificationDocType      VerificationDocType?
  verificationDocFrontPath String?              @db.VarChar(500)
  verificationDocBackPath  String?              @db.VarChar(500)
  verificationDocDeletedAt DateTime?

  district             String             @db.VarChar(80)
  dsDivision           String             @db.VarChar(80)

  status               RegistrationStatus @default(PENDING)
  rejectionNote        String?            @db.Text
  approvedAt           DateTime?
  approvedById         String?
  approvedBy           User?              @relation("DsApprovedBy", fields: [approvedById], references: [id])

  submittedAt          DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  submittedFromIp      String?            @db.VarChar(45)

  @@index([status])
  @@index([district])
  @@index([dsDivision])
  @@index([email])
  @@index([nic])
  @@map("divisional_secretariat_registrations")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String        @id @default(cuid())
  action      String        @db.VarChar(120)
  description String        @db.Text
  category    AuditCategory
  severity    AuditSeverity @default(INFO)

  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  userName    String        @db.VarChar(120)
  userIp      String?       @db.VarChar(45)
  userAgent   String?       @db.VarChar(500)

  metadata    Json?

  createdAt   DateTime      @default(now())

  @@index([category])
  @@index([severity])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Submission ───────────────────────────────────────────────────────────────

model Submission {
  id            String           @id @default(cuid())
  submittedById String
  submittedBy   User             @relation(fields: [submittedById], references: [id])

  year          Int              // reporting cycle, e.g. 2026 (represents the "2026/27" cycle)

  district      String           @db.VarChar(80)
  dsDivision    String           @db.VarChar(80)
  gnDivision    String           @db.VarChar(80)

  data          Json

  // Per-section DS decisions — Record<SectionKey, { status, note, reviewedById, reviewedAt }>,
  // parsed/validated in code via lib/submission-review.ts (parseSectionReviews). A section with
  // no entry is "pending" (undecided); never written as JSON null, always {} — see
  // lib/submission-review.ts for why. `status` below is derived from this, not set directly,
  // once any per-section decision has been made.
  sectionReviews Json?

  status        SubmissionStatus @default(DRAFT)
  // Whose queue this submission is in right now — independent of `status`. AD reviews first;
  // once AD clears every section this flips to DS. See lib/submission-review.ts
  // `deriveSubmissionStatus` for how status and reviewStage are advanced together.
  reviewStage   ReviewStage      @default(AD)
  rejectionNote String?          @db.Text
  reviewedById  String?
  reviewedAt    DateTime?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  divisionProfile DivisionProfile?

  @@unique([submittedById, year])
  @@index([submittedById])
  @@index([status])
  @@index([district])
  @@index([year])
  @@index([reviewStage, status])
  @@map("submissions")
}

// ─── Division Profile ──────────────────────────────────────────────────────
// The single "official" record for a GN division — created/overwritten only when a
// Divisional Secretariat approves a Submission. This is the division's current-truth
// snapshot: it feeds "My Division Information" analytics (approved data only, never
// mixed with draft/pending/rejected submissions) and seeds next year's submission
// draft, so officers update the existing record instead of starting from blank.
model DivisionProfile {
  id                 String     @id @default(cuid())

  district           String     @db.VarChar(80)
  dsDivision         String     @db.VarChar(80)
  gnDivision         String     @unique @db.VarChar(80)

  data               Json

  sourceSubmissionId String     @unique
  sourceSubmission   Submission @relation(fields: [sourceSubmissionId], references: [id])
  year               Int

  approvedById       String
  approvedBy         User       @relation("DivisionProfileApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([district])
  @@index([dsDivision])
  @@map("division_profiles")
}

// ─── System Settings ──────────────────────────────────────────────────────────

model SystemSetting {
  key       String   @id @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ─── Password Reset OTPs ───────────────────────────────────────────────────────
// One row per "forgot password" request. otpHash is a SHA-256 hash of the 6-digit
// code (not bcrypt — the code is short-lived, single-use, and already guarded by
// rate-limiting + a max attempt count, so a fast hash is enough and keeps
// verification instant). Superseded on every new request for the same email.

model PasswordResetOtp {
  id         String    @id @default(cuid())
  email      String    @db.VarChar(255)
  otpHash    String    @db.VarChar(64)
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  // Set once the OTP is verified and a reset token is issued — `jti` identifies that
  // token so /api/auth/reset-password can atomically claim it (see resetTokenUsedAt),
  // making the otherwise-stateless JWT single-use for its remaining lifetime.
  resetTokenJti    String?   @unique @db.VarChar(36)
  resetTokenUsedAt DateTime?

  @@index([email])
  @@map("password_reset_otps")
}
