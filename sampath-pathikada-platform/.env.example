# ─── MySQL ─────────────────────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=N&pool_timeout=S
#
# connection_limit / pool_timeout: this app runs as a SINGLE long-lived Docker
# container (see Dockerfile — no horizontal scaling / multiple replicas), so
# there is exactly one Prisma connection pool to size. Without an explicit
# connection_limit, Prisma defaults to (num_cpus * 2 + 1), which silently
# changes if the container's CPU allocation changes and is not itself checked
# against your MySQL server's max_connections. Set connection_limit explicitly
# and keep it comfortably under MySQL's max_connections (default 151 on stock
# MySQL 8) — 10 is a reasonable starting point for this app's traffic profile;
# raise it only with evidence (see DATABASE.md) that requests are queuing on
# pool exhaustion. pool_timeout is how long a request waits for a free
# connection before failing fast (seconds) rather than hanging indefinitely.
# If you DO ever scale to multiple instances, connection_limit must be divided
# across them — see DATABASE.md.
DATABASE_URL="mysql://root:yourpassword@localhost:3306/sampath_pathikada?connection_limit=10&pool_timeout=10"

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret-before-production"

# ─── Super Admin (bootstrapped into DB on first seed) ──────────────────────────
SUPER_ADMIN_EMAIL="superadmin@sampath.lk"
SUPER_ADMIN_PASSWORD="SuperAdmin@2026"

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3004"
NODE_ENV="development"

# ─── Resend (forgot-password OTP emails) ───────────────────────────────────────
# Get an API key at https://resend.com/api-keys. RESEND_FROM_EMAIL must be an
# address on a domain you've verified in Resend (or resend.dev for testing).
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="Sampath Pathikada <no-reply@yourdomain.com>"

# ─── Verification documents ─────────────────────────────────────────────────────
# Optional. Days a PENDING registration's uploaded NIC/license/passport image is
# kept before being purged by the stale-doc cleanup job. Defaults to 14 if unset.
VERIFICATION_DOC_RETENTION_DAYS="14"

# ─── Rate limiting (Redis/Valkey) ───────────────────────────────────────────────
# Required in production (see lib/rate-limit.ts — the app refuses to start in
# production without it, same fail-closed pattern as JWT_SECRET). Backs the
# login/forgot-password/verify-otp/registration rate limiters with a shared
# store so limits are enforced correctly across every horizontally-scaled app
# instance, not just whichever one received a given request. Any Redis-protocol
# server works, including Valkey. Falls back to REDIS_URL if unset; if you
# already point another feature at Redis under REDIS_URL and want rate-limit
# keys isolated (e.g. a separate logical DB or instance), set this explicitly.
# Left unset outside production, the app falls back to an in-memory limiter —
# fine for local dev/tests, never correct for a multi-instance deployment.
RATE_LIMIT_REDIS_URL="redis://localhost:6379"
